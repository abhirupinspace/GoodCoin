# Copy to .env.local and adjust. All optional; defaults shown.

# Contract to read and call. Demo (6-min epochs, tiny targets) by default.
# Production parameters: goodcoin-530a20.testnet
NEXT_PUBLIC_GOODCOIN_CONTRACT=goodcoin-demo-530a20.testnet

# Primary NEAR testnet RPC. Falls back to FastNEAR, then rpc.testnet.near.org.
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# Optional: turns design-doc paths on /about into links (e.g. https://github.com/<org>/<repo>).
NEXT_PUBLIC_REPO_URL=

# Optional, server-only: NearBlocks API key for /api/txns (keyless free tier is ~6 req/min).
NEARBLOCKS_API_KEY=
