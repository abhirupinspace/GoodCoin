# Which GOODCOIN deployment the site reads by default (testnet).
NEXT_PUBLIC_GOODCOIN_CONTRACT=goodfire-demo4-ab92.testnet
NEXT_PUBLIC_GOODCOIN_PRODUCTION=goodfire-prod-ab92.testnet
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
# The fire factory (anyone can launch a locked fire through it).
NEXT_PUBLIC_FACTORY=fires-ab92.testnet

# Neon: the chain mirror (server-only) and Realtime (live queries). Apply db/schema.sql once.
DATABASE_URL=
NEON_REALTIME_SECRET=
NEON_REALTIME_URL=
NEXT_PUBLIC_NEON_REALTIME_URL=
# Bearer token for GET /api/sync (called every minute by a Neon Function cron trigger).
CRON_SECRET=
# Keeper: a small account that calls the permissionless settle()/payout(). Its own key, its own gas.
KEEPER_ACCOUNT=
KEEPER_KEY=
# Local dev only, if your network refuses DNS for *.neon.tech.
NEON_DNS_OVERRIDE=
# Server-only, optional: NearBlocks key for /api/txns.
NEARBLOCKS_API_KEY=
